generator client {
  provider = "prisma-client-js"
}

// Datasource com os nomes de variavel que a integracao Vercel + Neon injeta
// automaticamente no projeto:
//   POSTGRES_PRISMA_URL      -> conexao "pooled" (usada pelo app em runtime)
//   POSTGRES_URL_NON_POOLING -> conexao direta   (usada por migrations/db push)
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
  AUDIO
  TEXT
  EMBED
  // Widget: item "vivo" (relogio, contagem regressiva, cronometro). A
  // configuracao viaja no campo `text`, em JSON (ver app/WidgetView.tsx).
  WIDGET
}

enum ActionType {
  SHOW
  CLEAR
  UPLOAD
  LIVE
}

// Canais que um mod modera na Twitch. Preenchido no login (OAuth) a partir da
// API da Twitch e usado pelo painel para listar os streamers do mod. A lista e
// substituida a cada login. `modLogin` = login da Twitch do mod (minusculo).
model ModeratedChannel {
  id               String   @id @default(cuid())
  modLogin         String
  broadcasterId    String
  broadcasterLogin String
  broadcasterName  String
  updatedAt        DateTime @updatedAt

  @@unique([modLogin, broadcasterId])
  @@index([modLogin])
}

// Acesso concedido "na mao": permite que um usuario controle a mesa de um
// streamer mesmo sem ser mod dele na Twitch. Quem ja tem acesso ao streamer
// (mod, master, o proprio streamer, ou alguem que ja recebeu acesso) pode
// conceder a outra pessoa. streamer/userLogin/grantedBy = logins minusculos.
model MesaAccess {
  id           String   @id @default(cuid())
  streamer     String // login do streamer (canal)
  streamerName String   @default("") // nome de exibicao do streamer
  userLogin    String // quem ganhou acesso
  grantedBy    String // quem concedeu
  createdAt    DateTime @default(now())

  @@unique([streamer, userLogin])
  @@index([userLogin])
  @@index([streamer])
}

// Convite de acesso a mesa de um streamer.
//
// Moderar o canal na Twitch NAO da mais acesso: o streamer gera um codigo e
// entrega a quem ele quiser, que pode nem ser mod. Cada codigo vale UMA vez.
// `forLogin` vazio = serve para quem usar primeiro, e fica registrado em
// `usedBy` quem foi.
model MesaInvite {
  id           String    @id @default(cuid())
  code         String    @unique // sem tracinho, caixa alta
  streamer     String // canal cuja mesa o codigo libera
  streamerName String    @default("")
  forLogin     String    @default("") // usuario previsto; vazio = qualquer um
  createdBy    String // quem gerou
  usedBy       String    @default("") // quem usou (vazio = ainda nao usado)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([streamer])
}

// Historico de logins: registra o PRIMEIRO login de cada usuario no painel.
// So o master (asrus12) ve essa lista. Guardamos apenas o nick da Twitch e a
// data/hora do primeiro acesso — nada alem disso. `login` = login minusculo
// (identidade canonica); `display` = nome de exibicao (capitalizacao original).
model LoginHistory {
  id           String   @id @default(cuid())
  login        String   @unique
  display      String   @default("")
  firstLoginAt DateTime @default(now())
  // true = data estimada a partir de rastros antigos (mídia/log/acessos), pois
  // o usuario ja usava o painel antes de existir o registro de login. false =
  // primeiro login registrado de verdade.
  approx       Boolean  @default(false)

  @@index([firstLoginAt])
}

// Biblioteca de midias (secao 2.5): apenas metadados; o binario fica no
// armazenamento de arquivos (Vercel Blob), aqui guardamos so a URL.
// A biblioteca e PRIVADA POR USUARIO: cada um so ve (dispara/exclui) o que ele
// mesmo cadastrou. `createdBy` = login da Twitch de quem cadastrou (minusculo)
// e e o dono da midia.
model Media {
  id        String    @id @default(cuid())
  name      String
  type      MediaType
  url       String
  tags      String[]  @default([])
  createdBy String // login da Twitch do dono da midia (quem cadastrou)
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([tags])
  @@index([createdBy])
}

// Estado atual do overlay (linha unica, id = "current"). Serve para o
// overlay recuperar o que esta na tela ao (re)carregar no OBS, ja que o
// Pusher nao repete eventos passados. Sem isso, um browser source que
// reconecta/atualiza fica em branco ate o proximo disparo.
model OverlayState {
  id        String     @id
  streamer  String     @default("") // streamer dono do overlay (overlay compartilhado)
  owner     String     @default("") // mod que colocou o item (mesa individual por mod)
  mediaId   String?
  url       String?
  text      String? // conteudo do item de texto (type = TEXT)
  type      MediaType?
  x         Float      @default(0.5)
  y         Float      @default(0.5)
  scale     Float      @default(1)
  scaleY    Float? // altura como fracao da tela; nulo = altura natural (sem distorcer)
  volume    Float      @default(1) // volume do audio/video (0..1)
  muted     Boolean    @default(false) // som mutado?
  hidden    Boolean    @default(false) // oculto (nao mostra no overlay nem toca som)
  sticky    Boolean    @default(false)
  expiresAt DateTime? // para "flash" (nao-sticky): some sozinho depois disso
  updatedAt DateTime   @updatedAt

  @@index([streamer])
  @@index([owner])
}

// Cena salva: um arranjo nomeado dos itens da mesa (posicao, tamanho, som,
// visibilidade), para o mod montar uma vez e reaplicar com um clique — ex.:
// "Inicio", "Intervalo", "Enquete". A cena e por mod E por streamer: cada um
// so ve e aplica as suas. `items` guarda o snapshot em JSON.
model Scene {
  id        String   @id @default(cuid())
  name      String
  streamer  String // login do streamer (canal) dono do overlay
  owner     String // mod dono da cena (mesa individual por mod)
  items     Json // snapshot dos itens da mesa no momento em que foi salva
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([streamer, owner, name])
  @@index([streamer, owner])
}

// Log de disparos (secao 2.5 / 7): auditoria de cada acao sensivel.
// Guarda um snapshot do nome da midia para o historico nao quebrar caso a
// midia seja removida depois.
model AuditLog {
  id         String     @id @default(cuid())
  action     ActionType
  actor      String // nome do mod que realizou a acao
  mediaId    String?
  mediaName  String?
  durationMs Int?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([actor])
}
